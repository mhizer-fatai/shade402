pragma language_version >= 0.23;

import CompactStandardLibrary;

// Shade402 v2 — private payer identity for x402-style agent payments.
//
// Wave-1 security invariants preserved: owner-gated provider allowlist,
// owner-only withdraw, on-chain invoice replay, allowlisted recipients.
//
// Privacy upgrade (v2): the public `agents: Map` is GONE. Per-agent balance
// and policy now live in the agent's private state (off-chain, threaded via
// witnesses). On-chain we keep only a HistoricMerkleTree whose leaves are
// H("shade402:agent-leaf:v2" || agentSecret). A payment proves membership in
// that tree with a private Merkle path — the chain learns that *some
// registered agent* paid, never which one, its balance, or its history.
//
// What is public (by design): provider allowlist, invoice replay hashes,
// aggregate deposit/settlement totals, the tree root. What is hidden: the
// payer's identity, balance, per-agent history, and the secret itself.
//
// Honest scope (v2): per-agent balance, daily-limit, and period state live in
// the agent's private state and are enforced in-ZK against the values the
// custodian reports (the chain cannot time-check private state, and does not
// store it). The contract itself enforces: agent membership (Merkle),
// owner allowlist, invoice replay, and real-money solvency via sendUnshielded
// against the contract's actual balance. Fully on-chain per-agent policy
// with unlinkable history is the shielded-state (coin) upgrade.

// Public ledger — minimal, nothing per-agent.
export ledger agents: HistoricMerkleTree<16, Bytes<32>>;
export ledger usedInvoices: Set<Bytes<32>>;
export ledger allowedProviders: Set<UserAddress>;
export sealed ledger owner: Bytes<32>;
export ledger lastSettledInvoice: Bytes<32>;
export ledger totalSettledAmount: Uint<64>;
export ledger totalDeposited: Uint<64>;

// Private witnesses.
// localSecret: the deployer's secret (owner authority, same as v1).
// agentSecret: the paying agent's secret — supplies the identity commitment.
// agentPath:    private Merkle path proving the agent's leaf is in the tree.
// The AgentState scalars are the agent's private policy/balance, read from
// the custodian-held private state so the circuit can enforce policy in-ZK
// without any of it touching the public ledger.
//
// NOTE on period rollover: spentInPeriod / dailyLimit are private values, so
// the circuit cannot call blockTimeGte on them (the compiler forbids time
// checks on witness data — it would leak a time boundary). The custodian
// therefore rolls the period over in its own private state before calling the
// circuit, and reports the current-period spent value. The circuit enforces
// that this payment fits within the reported spent/dailyLimit. This matches
// the honest scope documented at the top of the file.
witness localSecret(): Bytes<32>;
witness agentSecret(): Bytes<32>;
witness agentPath(): MerkleTreePath<16, Bytes<32>>;
witness policyBalance(): Uint<64>;
witness policyDailyLimit(): Uint<64>;
witness policySpentInPeriod(): Uint<64>;
witness policyPerPaymentLimit(): Uint<64>;

// Sealed at deployment: the owner key derived from the deployer's secret.
// Only the deployer can ever manage providers or withdraw funds.
constructor() {
    owner = disclose(ownerKey());
}

circuit agentLeaf(sk: Bytes<32>): Bytes<32> {
    return persistentHash<Vector<2, Bytes<32>>>([
        pad(32, "shade402:agent-leaf:v2"),
        sk
    ]);
}

// Owner key derived from the same secret but a different domain, so the
// owner's authorization key is distinct from an agent's identity.
circuit ownerKey(): Bytes<32> {
    return persistentHash<Vector<2, Bytes<32>>>([
        pad(32, "shade402:owner-key:v1"),
        localSecret()
    ]);
}

circuit requireOwner(): [] {
    assert(owner == disclose(ownerKey()), "Only the owner can call this circuit");
}

// Register an agent: append its identity commitment (leaf) to the tree.
// Owner-gated in v2: the balance/policy that authorize payments now live in
// private (witness) state, so letting anyone self-register would let an
// external actor claim an arbitrary private balance and drain the pool.
// The owner registers the agents it funds; the leaf is H(agentSecret), so the
// chain stores no key that an observer can map back to a real agent, and a
// payment later proves membership without revealing which leaf paid.
export circuit registerAgent(
    dailyLimit: Uint<64>,
    perPaymentLimit: Uint<64>
): [] {
    requireOwner();
    assert(dailyLimit > 0, "Daily limit must be positive");
    assert(perPaymentLimit > 0, "Payment limit must be positive");
    assert(perPaymentLimit <= dailyLimit, "Payment limit exceeds daily limit");

    const sk = agentSecret();
    const leaf = agentLeaf(sk);
    agents.insert(disclose(leaf));
}

// Owner-only: allow a provider address to receive payments. Agents can only
// ever pay allowlisted providers, which closes the self-pay drain.
export circuit allowProvider(provider: UserAddress): [] {
    requireOwner();
    assert(!allowedProviders.member(disclose(provider)), "Provider already allowed");
    allowedProviders.insert(disclose(provider));
}

// Owner-only: remove a provider from the allowlist.
export circuit revokeProvider(provider: UserAddress): [] {
    requireOwner();
    assert(allowedProviders.member(disclose(provider)), "Provider not in allowlist");
    allowedProviders.remove(disclose(provider));
}

// Deposit funds into the contract. The deposit is unshielded (public amount),
// which the provider must be able to verify anyway. Per-agent crediting stays
// in the agent's private state. totalDeposited is an aggregate, never
// attributed to an agent on-chain.
export circuit deposit(amount: Uint<64>): [] {
    assert(amount > 0, "Deposit amount must be positive");
    receiveUnshielded(nativeToken(), disclose(amount));
    totalDeposited = (totalDeposited + disclose(amount)) as Uint<64>;
}

// Owner-only: withdraw contract funds back to the owner's address. Escape
// hatch so deposited funds are never locked in the contract.
export circuit withdraw(amount: Uint<64>, destination: UserAddress): [] {
    requireOwner();
    assert(amount > 0, "Withdrawal amount must be positive");
    assert(unshieldedBalanceGte(nativeToken(), disclose(amount) as Uint<128>), "Insufficient contract balance");
    sendUnshielded(
        nativeToken(),
        disclose(amount) as Uint<128>,
        right<ContractAddress, UserAddress>(disclose(destination))
    );
}

// Private settlement: prove the caller is a registered agent (Merkle
// membership, payer identity hidden), that the invoice is unpaid, the
// recipient is allowlisted, and that the payment is within the agent's
// private policy — then settle to the provider.
export circuit payInvoice(
    recipient: UserAddress,
    invoiceHash: Bytes<32>,
    amount: Uint<64>
): [] {
    // 1. Membership without identity: recompute the agent's leaf from the
    //    private secret and verify it sits under a root the tree accepts.
    //    The path (and thus the leaf + position) never goes on-chain.
    const sk = agentSecret();
    const path = agentPath();
    const leaf = agentLeaf(sk);
    assert(path.leaf == leaf, "Merkle path leaf does not match derived agent commitment");
    const computed_root = merkleTreePathRoot<16, Bytes<32>>(disclose(path));
    assert(agents.checkRoot(computed_root), "Agent is not registered");

    // 2. Provider must be owner-allowlisted (drain protection).
    assert(allowedProviders.member(disclose(recipient)), "Recipient is not an allowed provider");

    // 3. Replay protection: an invoice can be settled at most once.
    assert(!usedInvoices.member(disclose(invoiceHash)), "Invoice has already been paid");

    // 4. Policy enforcement in-ZK over the agent's private state.
    assert(amount > 0, "Payment amount must be positive");
    const balance = policyBalance();
    const dailyLimit = policyDailyLimit();
    const spent = policySpentInPeriod();
    const perPaymentLimit = policyPerPaymentLimit();

    assert(balance >= amount, "Insufficient agent balance");
    assert(perPaymentLimit >= amount, "Payment exceeds per-payment limit");
    assert(spent + amount <= dailyLimit, "Payment exceeds daily limit");

    // 5. Settle. The payer-of-record is the Shade402 contract, so the
    //    provider sees "Shade402 paid" — never which agent.
    sendUnshielded(
        nativeToken(),
        disclose(amount) as Uint<128>,
        right<ContractAddress, UserAddress>(disclose(recipient))
    );

    // 6. Record public outcomes: invoice used, aggregate total updated.
    usedInvoices.insert(disclose(invoiceHash));
    lastSettledInvoice = disclose(invoiceHash);
    totalSettledAmount = (totalSettledAmount + disclose(amount)) as Uint<64>;
}
