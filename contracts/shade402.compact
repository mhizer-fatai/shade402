pragma language_version >= 0.23;

import CompactStandardLibrary;

// Shade402 v3 — on-chain committed policy notes (Wave 2).
//
// Removes the custodian trust gap that v2 documented: per-agent balance and
// spend are no longer free-floating witnesses reported by the backend. Each
// agent's policy lives in a commitment ("note") held in an append-only Merkle
// tree, and every state change consumes the current note by publishing a
// nullifier and appending a fresh note that proves, inside the circuit:
//
//     newBalance = oldBalance - amount
//     newSpent   = oldSpent   + amount
//
// Because every note descends from a real deposit (or from registration with a
// zero balance), a fabricated balance has no note to spend, a reused note is
// rejected by the nullifier set, and the daily limit is genuinely cumulative
// rather than custodian-reported.
//
// What stays public by design: settlement amounts, recipients, the provider
// allowlist, invoice hashes, aggregate totals, the identity tree root and the
// policy-note tree root. What stays hidden: the agent secret, which note is
// current, and every note field (balance, spend, limits, period end, nonce).
//
// Honest scope: the period end is passed as a *public* circuit parameter for
// the rollover time check (the compiler forbids time checks on private witness
// data), so it is disclosed; the proof binds that public value to the committed
// note. Custody of the agent secret still sits with the backend in this demo,
// but the backend can no longer invent a balance or bypass a limit.

// ─── Public ledger ──────────────────────────────────────────────────────────

// Identity commitments: H("shade402:agent-leaf:v2" || agentSecret). Unchanged
// from v2 so the existing privacy properties do not regress.
export ledger agents: HistoricMerkleTree<16, Bytes<32>>;

// Policy notes: H(domain || agentSecret || note fields). One live note per
// agent; spent notes stay in the tree but can never be used again.
export ledger notes: HistoricMerkleTree<16, Bytes<32>>;

// Nullifiers of consumed policy notes.
export ledger usedNullifiers: Set<Bytes<32>>;

export ledger usedInvoices: Set<Bytes<32>>;
export ledger allowedProviders: Set<UserAddress>;
export sealed ledger owner: Bytes<32>;
export ledger lastSettledInvoice: Bytes<32>;
export ledger totalSettledAmount: Uint<64>;
export ledger totalDeposited: Uint<64>;

// ─── Note shape ─────────────────────────────────────────────────────────────

struct PolicyNote {
    balance: Uint<64>;
    spentInPeriod: Uint<64>;
    dailyLimit: Uint<64>;
    perPaymentLimit: Uint<64>;
    periodEndsAt: Uint<64>;
    nonce: Bytes<32>;
}

// ─── Private witnesses ──────────────────────────────────────────────────────
// localSecret: deployer's secret (owner authority).
// agentSecret: the paying agent's secret; supplies the identity commitment and
//              is bound into every note, so only the agent can spend its notes.
// agentPath:   private Merkle path proving the agent's identity leaf is in the
//              agents tree.
// note/notePath: the agent's current policy note and its private Merkle path.
// nextNonce:   fresh randomness for the note being created. The client supplies
//              it and remembers the resulting note; a repeated nonce would only
//              harm the agent (the new note would duplicate a spent one).
witness localSecret(): Bytes<32>;
witness agentSecret(): Bytes<32>;
witness agentPath(): MerkleTreePath<16, Bytes<32>>;
witness note(): PolicyNote;
witness notePath(): MerkleTreePath<16, Bytes<32>>;
witness nextNonce(): Bytes<32>;

// ─── Construction ───────────────────────────────────────────────────────────

constructor() {
    owner = disclose(ownerKey());
}

circuit agentLeaf(sk: Bytes<32>): Bytes<32> {
    return persistentHash<Vector<2, Bytes<32>>>([
        pad(32, "shade402:agent-leaf:v2"),
        sk
    ]);
}

// Owner key derived from the same secret but a different domain, so the
// owner's authorization key is distinct from an agent's identity.
circuit ownerKey(): Bytes<32> {
    return persistentHash<Vector<2, Bytes<32>>>([
        pad(32, "shade402:owner-key:v1"),
        localSecret()
    ]);
}

circuit requireOwner(): [] {
    assert(owner == disclose(ownerKey()), "Only the owner can call this circuit");
}

// Commitment to a policy note. Every field is bound to the agent secret, so a
// note cannot be moved between agents and cannot be forged from public data.
// (`pad` only accepts string literals in this language version, so the numeric
// fields are hashed as a Uint vector first and that digest is bound to the
// domain, the agent secret and the nonce.)
circuit noteCommitment(sk: Bytes<32>, n: PolicyNote): Bytes<32> {
    const fields = persistentHash<Vector<5, Uint<64>>>([
        n.balance,
        n.spentInPeriod,
        n.dailyLimit,
        n.perPaymentLimit,
        n.periodEndsAt
    ]);
    return persistentHash<Vector<4, Bytes<32>>>([
        pad(32, "shade402:policy-note:v3"),
        sk,
        fields,
        n.nonce
    ]);
}

// A note can be consumed exactly once.
circuit nullifier(sk: Bytes<32>, nonce: Bytes<32>): Bytes<32> {
    return persistentHash<Vector<3, Bytes<32>>>([
        pad(32, "shade402:note-nullifier:v3"),
        sk,
        nonce
    ]);
}

// Shared prologue: prove the caller holds a registered identity and an active,
// unspent policy note. Returns the note so circuits can act on it.
circuit requireActiveNote(): PolicyNote {
    const sk = agentSecret();

    // 1. Identity: membership without revealing which leaf.
    const path = agentPath();
    const leaf = agentLeaf(sk);
    assert(path.leaf == leaf, "Merkle path leaf does not match derived agent commitment");
    assert(agents.checkRoot(merkleTreePathRoot<16, Bytes<32>>(disclose(path))), "Agent is not registered");

    // 2. Policy note: the caller's committed balance/limits are in the tree.
    const n = note();
    const np = notePath();
    assert(np.leaf == noteCommitment(sk, n), "Note path does not match the committed policy");
    assert(notes.checkRoot(merkleTreePathRoot<16, Bytes<32>>(disclose(np))), "Policy note is not active");

    // 3. Single use: the note has not been consumed.
    assert(!usedNullifiers.member(disclose(nullifier(sk, n.nonce))), "Policy note has already been spent");

    return n;
}

// Consume the caller's note and append its successor.
circuit replaceNote(sk: Bytes<32>, n: PolicyNote, next: PolicyNote): [] {
    usedNullifiers.insert(disclose(nullifier(sk, n.nonce)));
    notes.insert(disclose(noteCommitment(sk, next)));
}

// ─── Owner circuits ─────────────────────────────────────────────────────────

// Register an agent: append its identity commitment and mint its first policy
// note with a zero balance and the owner-set limits.
export circuit registerAgent(
    dailyLimit: Uint<64>,
    perPaymentLimit: Uint<64>,
    periodEndsAt: Uint<64>
): [] {
    requireOwner();
    assert(dailyLimit > 0, "Daily limit must be positive");
    assert(perPaymentLimit > 0, "Payment limit must be positive");
    assert(perPaymentLimit <= dailyLimit, "Payment limit exceeds daily limit");

    const sk = agentSecret();
    agents.insert(disclose(agentLeaf(sk)));
    notes.insert(disclose(noteCommitment(sk, PolicyNote {
        balance: 0,
        spentInPeriod: 0,
        dailyLimit: dailyLimit,
        perPaymentLimit: perPaymentLimit,
        periodEndsAt: periodEndsAt,
        nonce: nextNonce()
    })));
}

// Owner-only: allow a provider address to receive payments.
export circuit allowProvider(provider: UserAddress): [] {
    requireOwner();
    assert(!allowedProviders.member(disclose(provider)), "Provider already allowed");
    allowedProviders.insert(disclose(provider));
}

// Owner-only: remove a provider from the allowlist.
export circuit revokeProvider(provider: UserAddress): [] {
    requireOwner();
    assert(allowedProviders.member(disclose(provider)), "Provider not in allowlist");
    allowedProviders.remove(disclose(provider));
}

// Owner-only: withdraw contract funds back to the owner's address.
export circuit withdraw(amount: Uint<64>, destination: UserAddress): [] {
    requireOwner();
    assert(amount > 0, "Withdrawal amount must be positive");
    assert(unshieldedBalanceGte(nativeToken(), disclose(amount) as Uint<128>), "Insufficient contract balance");
    sendUnshielded(
        nativeToken(),
        disclose(amount) as Uint<128>,
        right<ContractAddress, UserAddress>(disclose(destination))
    );
}

// ─── Agent circuits ─────────────────────────────────────────────────────────

// Credit the caller's committed balance and reissue the note. Deposits are
// public in amount (providers must be able to verify funding) but the note
// keeps which agent credits it private.
export circuit deposit(amount: Uint<64>): [] {
    const sk = agentSecret();
    const n = requireActiveNote();
    assert(amount > 0, "Deposit amount must be positive");

    receiveUnshielded(nativeToken(), disclose(amount));
    totalDeposited = (totalDeposited + disclose(amount)) as Uint<64>;

    replaceNote(sk, n, PolicyNote {
        balance: (n.balance + amount) as Uint<64>,
        spentInPeriod: n.spentInPeriod,
        dailyLimit: n.dailyLimit,
        perPaymentLimit: n.perPaymentLimit,
        periodEndsAt: n.periodEndsAt,
        nonce: nextNonce()
    });
}

// Roll a finished period over: reset the committed spend and extend the period
// end. The period end is a public parameter so the chain can time-check it; the
// proof binds it to the committed note, so it cannot be rolled early or with a
// fabricated period.
export circuit rollPeriod(periodEndsAtPublic: Uint<64>): [] {
    const sk = agentSecret();
    const n = requireActiveNote();
    assert(n.periodEndsAt == periodEndsAtPublic, "Period end does not match the committed note");
    assert(blockTimeGte(disclose(periodEndsAtPublic)), "Period has not ended yet");

    replaceNote(sk, n, PolicyNote {
        balance: n.balance,
        spentInPeriod: 0,
        dailyLimit: n.dailyLimit,
        perPaymentLimit: n.perPaymentLimit,
        periodEndsAt: (n.periodEndsAt + 86400) as Uint<64>,
        nonce: nextNonce()
    });
}

// Private settlement: consume the agent's note, prove in-circuit that the
// payment is funded and within the committed policy, and reissue the note with
// the updated balance and spend. The payer of record remains the contract.
export circuit payInvoice(
    recipient: UserAddress,
    invoiceHash: Bytes<32>,
    amount: Uint<64>
): [] {
    const sk = agentSecret();
    const n = requireActiveNote();

    // Provider must be owner-allowlisted (drain protection).
    assert(allowedProviders.member(disclose(recipient)), "Recipient is not an allowed provider");

    // Replay protection: an invoice can be settled at most once.
    assert(!usedInvoices.member(disclose(invoiceHash)), "Invoice has already been paid");

    // Policy, now provably tied to a chain of committed notes.
    assert(amount > 0, "Payment amount must be positive");
    assert(n.balance >= amount, "Insufficient agent balance");
    assert(n.perPaymentLimit >= amount, "Payment exceeds per-payment limit");
    assert(n.spentInPeriod + amount <= n.dailyLimit, "Payment exceeds daily limit");

    // Settle. The provider sees "Shade402 paid" — never which agent.
    sendUnshielded(
        nativeToken(),
        disclose(amount) as Uint<128>,
        right<ContractAddress, UserAddress>(disclose(recipient))
    );

    // Consume the note and append its successor.
    replaceNote(sk, n, PolicyNote {
        balance: (n.balance - amount) as Uint<64>,
        spentInPeriod: (n.spentInPeriod + amount) as Uint<64>,
        dailyLimit: n.dailyLimit,
        perPaymentLimit: n.perPaymentLimit,
        periodEndsAt: n.periodEndsAt,
        nonce: nextNonce()
    });

    usedInvoices.insert(disclose(invoiceHash));
    lastSettledInvoice = disclose(invoiceHash);
    totalSettledAmount = (totalSettledAmount + disclose(amount)) as Uint<64>;
}
